@{
    bool isDashboardPage = ViewData["isDashboard"] != null;
    bool isUserPage = ViewData["isUserPage"] != null;

    var items = new List<Syncfusion.EJ2.Navigations.BreadcrumbItem>();
    items.Add(new Syncfusion.EJ2.Navigations.BreadcrumbItem
    {
        IconCss = "fa-solid fa-house",
        Url = Url.Action("Index", "Dashboard")
    });

    string controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
    string action = ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty;

    string controllerLabel = controller switch
    {
        "Dashboard" => "Pulpit",
        "Transaction" => "Transakcje",
        "Category" => "Kategorie",
        "Subscription" => "Subskrypcje",
        "Scanner" => "Skaner AI",
        "Report" => "Raporty PDF",
        "Notification" => "Powiadomienia",
        "Home" => "Profil",
        "Admin" => "Administracja",
        _ => controller
    };

    if (!string.IsNullOrEmpty(controller) && (controller != "Home" || (action != "Dashboard" && action != "Index")))
    {
        items.Add(new Syncfusion.EJ2.Navigations.BreadcrumbItem
        {
            Text = controllerLabel,
            Url = controller == "Home" ? Url.Action("User", "Home") : Url.Action("Index", controller)
        });

        if (action != "Index" && !(controller == "Home" && action == "User"))
        {
            string actionLabel;
            if (action == "AddOrEdit")
            {
                string? routeId = ViewContext.RouteData.Values["id"]?.ToString();
                string queryId = Context.Request.Query["id"].ToString();
                bool hasId = (!string.IsNullOrEmpty(routeId) && routeId != "0") || (!string.IsNullOrEmpty(queryId) && queryId != "0");
                actionLabel = hasId ? "Edytuj" : "Dodaj";
            }
            else if (action == "Compare")
            {
                actionLabel = "Porównanie miesięcy";
            }
            else
            {
                actionLabel = action;
            }

            items.Add(new Syncfusion.EJ2.Navigations.BreadcrumbItem
            {
                Text = actionLabel
            });
        }
    }
}
<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Expense Tracker</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link id="syncfusion-theme" rel="stylesheet" href="https://cdn.syncfusion.com/ej2/25.2.3/fabric.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" integrity="sha512-SnH5WK+bZxgPHs44uWIX+LLJAJ9/2PkPKZ5QiAj6Ta86w+fsb2TkcmfRyVX3pBnMFcV7oQPJkl9QevSCWr3W6A==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ExpenseTracker.styles.css" asp-append-version="true" />
    <script src="https://cdn.syncfusion.com/ej2/25.2.3/dist/ej2.min.js"></script>
</head>

<body>
    <script>
        (function () {
            if (localStorage.getItem('expenseTracker_darkMode') === 'true') {
                document.body.classList.add('dark-mode');
                const themeLink = document.getElementById('syncfusion-theme');
                if (themeLink) {
                    themeLink.href = 'https://cdn.syncfusion.com/ej2/25.2.3/fabric-dark.css';
                }
            }
        })();
    </script>

    @if (isDashboardPage || isUserPage)
    {
        <div id="loading-overlay" class="loading-overlay">
            <div class="custom-loader-box">
                <div id="syncfusion-spinner" style="width: 56px; height: 56px; position: relative;"></div>
                <span class="loader-label">Ładowanie danych...</span>
            </div>
        </div>
        <script>
            (function () {
                const spinnerTarget = document.getElementById('syncfusion-spinner');
                if (spinnerTarget && typeof ej !== 'undefined' && ej.popups) {
                    ej.popups.createSpinner({ target: spinnerTarget, width: '48px' });
                    ej.popups.showSpinner(spinnerTarget);
                }
            })();
        </script>
    }

    <partial name="_SideBar.cshtml" />

    <div class="page-wrapper">
        <partial name="_NavBar.cshtml" />

        <main role="main" class="main-content">
            <div class="container-fluid px-4 py-4">
                <div class="row justify-content-center">
                    <div class="@(isDashboardPage ? "col-12" : "col-xl-11 col-12")">
                        @if (!isDashboardPage)
                        {
                            <div class="d-flex flex-column mb-4">
                                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-1">
                                    <h3 class="fw-bold mb-0">@ViewData["PageTitle"]</h3>
                                    @if (ViewData["PageActionText"] != null)
                                    {
                                        <a class="btn btn-success text-white" href="@ViewData["PageActionUrl"]">
                                            @ViewData["PageActionText"]
                                        </a>
                                    }
                                </div>
                                @Html.EJS().Breadcrumb("default").Items(items).SeparatorTemplate("<span class='fa-solid fa-angle-right'></span>").Render()
                            </div>
                        }
                        @RenderBody()
                    </div>
                </div>
            </div>
        </main>

        <footer class="app-footer">
            <div class="container-fluid px-4 d-flex flex-wrap justify-content-between align-items-center gap-2">
                <span>Expense Tracker &copy; @DateTime.Now.Year</span>
                <a href="https://github.com/Lizardzik" target="_blank" rel="noopener noreferrer" class="footer-github-link">
                    <i class="fa-brands fa-github me-1"></i>Rafał Jasiura
                </a>
            </div>
        </footer>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
    @Html.EJS().ScriptManager()
</body>
</html>