@model ErrorViewModel
@{
    ViewData["PageTitle"] = "Błąd aplikacji";
}

<div class="widget p-4 text-center">
    <i class="fa-solid fa-triangle-exclamation fa-3x text-danger mb-3"></i>
    <h4 class="fw-bold mb-2">Wystąpił nieoczekiwany błąd</h4>
    <p class="text-muted mb-3">Nie udało się przetworzyć żądania. Spróbuj ponownie lub wróć na pulpit główny.</p>

    @if (Model.ShowRequestId)
    {
        <p class="small text-muted mb-4">
            Identyfikator żądania: <code>@Model.RequestId</code>
        </p>
    }

    <a href="/Dashboard" class="btn btn-success">Wróć do pulpitu</a>
</div>