@using System.Globalization
@model dynamic
@{
    ViewData["PageTitle"] = "Raport Finansowy i Diagnoza";
    ViewData["UseLoader"] = true;
    CultureInfo culture = CultureInfo.CreateSpecificCulture("pl-PL");

    var insights = ViewBag.Insights as List<ExpenseTracker.Controllers.FinancialInsight> ?? new();
    var categories = ViewBag.CategoryBreakdown as List<ExpenseTracker.Controllers.ReportCategoryItem> ?? new();
    var topExpenses = ViewBag.TopExpenses as List<ExpenseTracker.Models.Transaction> ?? new();

    decimal walletBalance = ViewBag.WalletBalance != null ? (decimal)ViewBag.WalletBalance : 0m;
    decimal totalIncome = ViewBag.TotalIncome != null ? (decimal)ViewBag.TotalIncome : 0m;
    decimal totalExpense = ViewBag.TotalExpense != null ? (decimal)ViewBag.TotalExpense : 0m;
    decimal balance = ViewBag.Balance != null ? (decimal)ViewBag.Balance : 0m;
    decimal prevTotalExpense = ViewBag.PrevTotalExpense != null ? (decimal)ViewBag.PrevTotalExpense : 0m;
}

<div class="widget p-4 mb-4 no-print">
    <div class="row g-3 align-items-end">
        <div class="col-md-8">
            <form asp-action="Index" method="get" class="row g-2 align-items-end">
                <div class="col-sm-4">
                    <label class="form-label small fw-bold mb-1">Od dnia</label>
                    <input type="date" name="startDate" value="@ViewBag.StartDate" class="form-control" />
                </div>
                <div class="col-sm-4">
                    <label class="form-label small fw-bold mb-1">Do dnia</label>
                    <input type="date" name="endDate" value="@ViewBag.EndDate" class="form-control" />
                </div>
                <div class="col-sm-4">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="fa-solid fa-rotate me-1"></i>Odśwież dane
                    </button>
                </div>
            </form>
        </div>
        <div class="col-md-4 text-md-end">
            <button type="button" onclick="window.print()" class="btn btn-danger px-4 py-2 fw-bold w-100 w-md-auto">
                <i class="fa-solid fa-file-pdf me-2"></i>Pobierz / Zapisz PDF
            </button>
        </div>
    </div>
</div>

<div class="print-only mb-4 border-bottom pb-3">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h2 class="fw-bold mb-1">Raport Finansowy</h2>
            <p class="text-muted mb-0">Analizowany okres: <strong>@ViewBag.PeriodDisplay</strong> (w odniesieniu do: @ViewBag.PrevPeriodDisplay)</p>
        </div>
        <div class="text-end">
            <span class="small text-muted">Wygenerowano: @DateTime.Now.ToString("dd.MM.yyyy HH:mm")</span>
            <h5 class="fw-bold text-success mb-0">Stan portfela: @walletBalance.ToString("N2", culture) zł</h5>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-3 col-6">
        <div class="widget p-3 text-center h-100">
            <span class="text-muted small">Przychody</span>
            <h4 class="fw-bold text-success mt-1 mb-0">@totalIncome.ToString("N2", culture) zł</h4>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="widget p-3 text-center h-100">
            <span class="text-muted small">Wydatki</span>
            <h4 class="fw-bold text-danger mt-1 mb-0">@totalExpense.ToString("N2", culture) zł</h4>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="widget p-3 text-center h-100">
            <span class="text-muted small">Bilans okresu</span>
            <h4 class="fw-bold @(balance >= 0 ? "text-success" : "text-danger") mt-1 mb-0">@balance.ToString("N2", culture) zł</h4>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="widget p-3 text-center h-100">
            <span class="text-muted small">Poprzedni okres</span>
            <h4 class="fw-bold text-secondary mt-1 mb-0">@prevTotalExpense.ToString("N2", culture) zł</h4>
        </div>
    </div>
</div>

<div class="widget p-4 mb-4">
    <h5 class="fw-bold mb-3"><i class="fa-solid fa-stethoscope text-danger me-2"></i>Diagnoza finansowa i wykryte problemy</h5>
    <div class="row g-3">
        @foreach (var item in insights)
        {
            string borderClass = item.Severity == "danger" ? "border-danger bg-danger bg-opacity-10" :
            item.Severity == "warning" ? "border-warning bg-warning bg-opacity-10" :
            item.Severity == "success" ? "border-success bg-success bg-opacity-10" :
            "border-info bg-info bg-opacity-10";

            string iconClass = item.Severity == "danger" ? "fa-triangle-exclamation text-danger" :
            item.Severity == "warning" ? "fa-circle-exclamation text-warning" :
            item.Severity == "success" ? "fa-circle-check text-success" :
            "fa-circle-info text-info";

            <div class="col-md-6">
                <div class="p-3 rounded border-start border-4 @borderClass h-100">
                    <div class="d-flex align-items-center mb-1">
                        <i class="fa-solid @iconClass me-2"></i>
                        <strong>@item.Title</strong>
                    </div>
                    <p class="small text-muted mb-0">@item.Description</p>
                </div>
            </div>
        }
    </div>
</div>

@if (!categories.Any())
{
    <div class="widget p-5 mb-4 text-center">
        <i class="fa-solid fa-chart-pie fa-3x text-muted mb-3"></i>
        <h6 class="fw-bold">Brak wydatków w wybranym okresie (@ViewBag.PeriodDisplay)</h6>
        <p class="text-muted small mb-0">Dodaj transakcje lub wybierz szerszy zakres dat powyżej, aby wygenerować wykresy porównawcze.</p>
    </div>
}
else
{
    <div class="row g-4 mb-4">
        <div class="col-md-5">
            <div class="widget p-4 h-100">
                <h6 class="fw-bold text-center mb-3">Udział kategorii w wydatkach</h6>
                @Html.EJS().AccumulationChart("reportPieChart").Background("transparent").Height("320px").EnableSmartLabels(true).Series(series =>
                {
                    series.DataLabel(dl => dl.Visible(true).Name("CategoryTitle").Position(Syncfusion.EJ2.Charts.AccumulationLabelPosition.Inside))
                    .XName("CategoryTitle")
                    .YName("Amount")
                    .InnerRadius("50%")
                    .DataSource(categories)
                    .Add();
                }).LegendSettings(lg => lg.Visible(true).Position(Syncfusion.EJ2.Charts.LegendPosition.Bottom)).Tooltip(tt => tt.Enable(true)).Render()
                                                                                                                                                 </div>
                                                                                                                                             </div>
                                                                                                                                             <div class="col-md-7">
                                                                                                                                                 <div class="widget p-4 h-100">
                                                                                                                                                     <h6 class="fw-bold text-center mb-3">Obecny okres vs Poprzedni okres</h6>
                                                                                                                                                     @Html.EJS().Chart("reportBarChart").Background("transparent").Height("320px").Palettes(new string[] { "#dc3545", "#adb5bd" }).PrimaryXAxis(px => px
                .ValueType(Syncfusion.EJ2.Charts.ValueType.Category)
                        ).PrimaryYAxis(py => py.Minimum(0)).Series(series =>
                        {
                            series.Type(Syncfusion.EJ2.Charts.ChartSeriesType.Column)
                            .XName("CategoryTitle")
                            .YName("Amount")
                            .Name("Wybrany okres")
                            .DataSource(categories)
                            .Add();
                            series.Type(Syncfusion.EJ2.Charts.ChartSeriesType.Column)
                            .XName("CategoryTitle")
                            .YName("PreviousAmount")
                            .Name("Poprzedni okres")
                            .DataSource(categories)
                            .Add();
                        }).LegendSettings(lg => lg.Visible(true).Position(Syncfusion.EJ2.Charts.LegendPosition.Bottom)).Tooltip(tt => tt.Enable(true)).Render()
        </div>
    </div>
</div>
}

<div class="row g-4">
    <div class="col-md-7">
        <div class="widget p-4 h-100">
            <h6 class="fw-bold mb-3">Zestawienie wydatków według kategorii</h6>
            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Kategoria</th>
                            <th class="text-center">Operacje</th>
                            <th class="text-end">Kwota</th>
                            <th class="text-end">Udział</th>
                            <th class="text-end">Zmiana</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!categories.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center text-muted py-3">Brak wydatków w wybranym okresie.</td>
                            </tr>
                        }
                        @foreach (var c in categories)
                        {
                            <tr>
                                <td class="fw-bold">
                                    <div class="d-flex align-items-center gap-2">
                                        <i class="@c.CategoryIcon text-danger" style="width: 18px; text-align: center;"></i>
                                        <span>@c.CategoryTitle</span>
                                    </div>
                                </td>
                                <td class="text-center">@c.TransactionsCount</td>
                                <td class="text-end fw-bold">@c.Amount.ToString("N2", culture) zł</td>
                                <td class="text-end">@c.SharePercentage.ToString("0.#", culture)%</td>
                                <td class="text-end">
                                    @if (c.Difference > 0)
                                    {
                                        <span class="text-danger">+@c.Difference.ToString("N2", culture) zł</span>
                                    }
                                    else if (c.Difference < 0)
                                    {
                                        <span class="text-success">@c.Difference.ToString("N2", culture) zł</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">0,00 zł</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-md-5">
        <div class="widget p-4 h-100">
            <h6 class="fw-bold mb-3">10 największych wydatków w okresie</h6>
            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Data</th>
                            <th>Kategoria / Opis</th>
                            <th class="text-end">Kwota</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!topExpenses.Any())
                        {
                            <tr>
                                <td colspan="3" class="text-center text-muted py-3">Brak transakcji.</td>
                            </tr>
                        }
                        @foreach (var t in topExpenses)
                        {
                            <tr>
                                <td class="small text-muted">@t.Date.ToString("dd.MM.yyyy")</td>
                                <td>
                                    @if (t.Category != null)
                                    {
                                        <div class="fw-bold small d-flex align-items-center gap-1">
                                            <i class="@t.Category.Icon text-danger"></i>
                                            <span>@t.Category.Title</span>
                                        </div>
                                    }
                                    @if (!string.IsNullOrEmpty(t.Note))
                                    {
                                        <div class="text-muted" style="font-size: 0.78rem;">@t.Note</div>
                                    }
                                </td>
                                <td class="text-end text-danger fw-bold">-@t.Amount.ToString("N2", culture) zł</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<style>
    .print-only {
        display: none;
    }

    @@media print {
        body {
            background-color: #fff !important;
            color: #000 !important;
        }

        #default-sidebar,
        .my-navbar,
        .mobile-bottom-nav,
        .app-footer,
        .no-print,
        .e-breadcrumb {
            display: none !important;
        }

        .page-wrapper,
        .main-content {
            margin-left: 0 !important;
            padding: 0 !important;
            width: 100% !important;
        }

        .widget {
            background-color: #fff !important;
            border: 1px solid #ddd !important;
            box-shadow: none !important;
            break-inside: avoid;
        }

        .print-only {
            display: block !important;
        }
    }
</style>