@model ExpenseTracker.Models.Category
@{
    ViewData["PageTitle"] = Model.CategoryId == 0 ? "Nowa kategoria" : "Edycja kategorii";
    string currentType = string.IsNullOrWhiteSpace(Model.Type) ? "Expense" : Model.Type;
    string currentIcon = string.IsNullOrWhiteSpace(Model.Icon) ? "fa-solid fa-cart-shopping" : Model.Icon;

    string[] availableIcons = new[]
    {
        "fa-solid fa-paw",
        "fa-solid fa-dog",
        "fa-solid fa-cat",
        "fa-solid fa-cart-shopping",
        "fa-solid fa-utensils",
        "fa-solid fa-mug-hot",
        "fa-solid fa-house",
        "fa-solid fa-bolt",
        "fa-solid fa-wifi",
        "fa-solid fa-car",
        "fa-solid fa-gas-pump",
        "fa-solid fa-bus",
        "fa-solid fa-plane",
        "fa-solid fa-heart-pulse",
        "fa-solid fa-pills",
        "fa-solid fa-dumbbell",
        "fa-solid fa-film",
        "fa-solid fa-gamepad",
        "fa-solid fa-music",
        "fa-solid fa-graduation-cap",
        "fa-solid fa-book",
        "fa-solid fa-shirt",
        "fa-solid fa-scissors",
        "fa-solid fa-wrench",
        "fa-solid fa-money-bill-wave",
        "fa-solid fa-wallet",
        "fa-solid fa-laptop-code",
        "fa-solid fa-chart-line",
        "fa-solid fa-piggy-bank",
        "fa-solid fa-gift",
        "fa-solid fa-box-open"
    };
}

<div class="row">
    <div class="col-lg-7">
        <div class="widget p-4">
            <form asp-action="AddOrEdit" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <input type="hidden" asp-for="CategoryId" />

                <div class="type-toggle-container">
                    <label class="form-label fw-semibold">Typ kategorii</label>
                    <div class="type-toggle-group">
                        <div class="toggle-option">
                            <input type="radio" id="typeExpense" name="Type" value="Expense" class="toggle-input" @(currentType == "Expense" ? "checked" : "") />
                            <label for="typeExpense" class="toggle-label expense-toggle">
                                <i class="fa-solid fa-arrow-trend-down"></i>
                                <span>Wydatek</span>
                            </label>
                        </div>
                        <div class="toggle-option">
                            <input type="radio" id="typeIncome" name="Type" value="Income" class="toggle-input" @(currentType == "Income" ? "checked" : "") />
                            <label for="typeIncome" class="toggle-label income-toggle">
                                <i class="fa-solid fa-arrow-trend-up"></i>
                                <span>Przychód</span>
                            </label>
                        </div>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Title" class="form-label fw-semibold">Nazwa kategorii</label>
                    <input asp-for="Title" class="form-control" placeholder="np. Zwierzęta" />
                    <span asp-validation-for="Title" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label class="form-label fw-semibold">Wybierz ikonę</label>
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <div class="icon-preview-box">
                            <i id="selectedIconPreview" class="@currentIcon"></i>
                        </div>
                        <input asp-for="Icon" id="iconClassInput" class="form-control" value="@currentIcon" readonly />
                    </div>

                    <div class="icon-picker-grid">
                        @foreach (string iconClass in availableIcons)
                        {
                            <button type="button"
                                    class="icon-picker-btn @(currentIcon == iconClass ? "active" : "")"
                                    data-icon="@iconClass"
                                    title="@iconClass">
                                <i class="@iconClass"></i>
                            </button>
                        }
                    </div>
                    <span asp-validation-for="Icon" class="text-danger small"></span>
                </div>

                <div class="d-flex flex-wrap gap-2">
                    <button type="submit" class="btn btn-success">
                        <i class="fa-solid fa-check me-1"></i>Zapisz
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Anuluj</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const iconInput = document.getElementById('iconClassInput');
            const iconPreview = document.getElementById('selectedIconPreview');
            const pickerButtons = document.querySelectorAll('.icon-picker-btn');

            pickerButtons.forEach(function (button) {
                button.addEventListener('click', function () {
                    const chosenIcon = this.getAttribute('data-icon');
                    if (!chosenIcon) return;

                    pickerButtons.forEach(function (btn) {
                        btn.classList.remove('active');
                    });
                    this.classList.add('active');

                    if (iconInput) {
                        iconInput.value = chosenIcon;
                    }
                    if (iconPreview) {
                        iconPreview.className = chosenIcon;
                    }
                });
            });
        });
    </script>
}