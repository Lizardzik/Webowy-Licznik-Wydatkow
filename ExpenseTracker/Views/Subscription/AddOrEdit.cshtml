@model ExpenseTracker.Models.Subscription
@{
    ViewData["PageTitle"] = Model.SubscriptionId == 0 ? "Nowa Subskrypcja" : "Edytuj Subskrypcję";
}

<div class="row">
    <div class="col-md-7">
        <div class="widget p-5">
            <form asp-action="AddOrEdit" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input type="hidden" asp-for="SubscriptionId" />

                <div class="mb-3">
                    <label class="form-label fw-bold">Nazwa subskrypcji / opłaty</label>
                    <input asp-for="Title" class="form-control" placeholder="np. Netflix, Spotify, Czynsz, Siłownia" />
                    <span asp-validation-for="Title" class="text-danger fs-6"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Kategoria wydatku</label>
                    @Html.EJS().DropDownListFor(m => m.CategoryId).DataSource((IEnumerable<object>)ViewBag.Categories).Fields(new Syncfusion.EJ2.DropDowns.DropDownListFieldSettings { Value = "CategoryId", Text = "TitleWithIcon" }).Placeholder("Wybierz kategorię").FloatLabelType(Syncfusion.EJ2.Inputs.FloatLabelType.Never).Render()
                    <span asp-validation-for="CategoryId" class="text-danger fs-6"></span>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Kwota (PLN)</label>
                        <input asp-for="Amount" type="number" min="1" class="form-control" />
                        <span asp-validation-for="Amount" class="text-danger fs-6"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Dzień miesiąca (1 - 31)</label>
                        <input asp-for="BillingDay" type="number" min="1" max="31" class="form-control" />
                        <span asp-validation-for="BillingDay" class="text-danger fs-6"></span>
                    </div>
                </div>

                <div class="form-check form-switch mb-4 mt-2">
                    <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                    <label class="form-check-label" asp-for="IsActive">Subskrypcja aktywna (automatycznie pobieraj z portfela)</label>
                </div>

                <button type="submit" class="btn btn-success px-4">Zapisz subskrypcję</button>
                <a href="/Subscription" class="btn btn-outline-secondary ms-2">Anuluj</a>
            </form>
        </div>
    </div>
    <div class="col-md-5">
        <div class="widget h-100 d-flex flex-column justify-content-center align-items-center p-4 text-center">
            <i class="fa-solid fa-calendar-check fa-4x text-success mb-3"></i>
            <h5>Jak działają subskrypcje?</h5>
            <p class="text-muted small">
                Wskazujesz dzień miesiąca, w którym opłata schodzi z konta. Aplikacja przypomni Ci o niej 3 dni wcześniej, a w dniu płatności sama utworzy transakcję i pomniejszy stan Twojego portfela.
            </p>
        </div>
    </div>
</div>