@model ExpenseTracker.Models.Subscription
@{
    ViewData["PageTitle"] = Model.SubscriptionId == 0 ? "Nowa Subskrypcja" : "Edytuj Subskrypcję";
    ViewData["UseLoader"] = true;
}

<div class="row g-4">
    <div class="col-md-7">
        <div class="widget p-4">
            <form asp-action="AddOrEdit" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <input type="hidden" asp-for="SubscriptionId" />

                <div class="mb-3">
                    <label asp-for="Title" class="form-label fw-bold">Nazwa subskrypcji / opłaty</label>
                    <input asp-for="Title" class="form-control" placeholder="np. Netflix, Spotify, Czynsz, Siłownia" />
                    <span asp-validation-for="Title" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="CategoryId" class="form-label fw-bold">Kategoria wydatku</label>
                    <select asp-for="CategoryId" class="form-select" data-category-select="true">
                        <option value="0">Wybierz kategorię</option>
                        @if (ViewBag.Categories is IEnumerable<ExpenseTracker.Models.Category> categories)
                        {
                            foreach (var category in categories)
                            {
                                <option value="@category.CategoryId" data-icon="@category.Icon" data-type="@category.Type">@category.Title</option>
                            }
                        }
                    </select>
                    <span asp-validation-for="CategoryId" class="text-danger small"></span>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Amount" class="form-label fw-bold">Kwota (PLN)</label>
                        <input asp-for="Amount" type="text" inputmode="decimal" class="form-control" placeholder="0,00" value="@(Model.Amount == 0 ? string.Empty : Model.Amount.ToString("0.##"))" />
                        <span asp-validation-for="Amount" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="BillingDay" class="form-label fw-bold">Dzień miesiąca (1 - 31)</label>
                        <input asp-for="BillingDay" type="number" min="1" max="31" inputmode="numeric" class="form-control" />
                        <span asp-validation-for="BillingDay" class="text-danger small"></span>
                    </div>
                </div>

                <div class="form-check form-switch mb-4 mt-2">
                    <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                    <label class="form-check-label" asp-for="IsActive">Subskrypcja aktywna (automatycznie pobieraj z portfela)</label>
                </div>

                <div class="d-flex flex-wrap gap-2">
                    <button type="submit" class="btn btn-success px-4">
                        <i class="fa-solid fa-check me-1"></i>Zapisz subskrypcję
                    </button>
                    <a href="/Subscription" class="btn btn-outline-secondary">Anuluj</a>
                </div>
            </form>
        </div>
    </div>
    <div class="col-md-5">
        <div class="widget h-100 d-flex flex-column justify-content-center align-items-center p-4 text-center">
            <i class="fa-solid fa-calendar-check fa-4x text-success mb-3"></i>
            <h5>Jak działają subskrypcje?</h5>
            <p class="text-muted small mb-0">
                Wskazujesz dzień miesiąca, w którym opłata schodzi z konta. Aplikacja przypomni Ci o niej 3 dni wcześniej, a w dniu płatności sama utworzy transakcję i pomniejszy stan Twojego portfela.
            </p>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}