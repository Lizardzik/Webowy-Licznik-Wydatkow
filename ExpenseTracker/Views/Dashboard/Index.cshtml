@using System.Globalization
@model ExpenseTracker.Models.User
@{
    ViewData["isDashboard"] = true;
    CultureInfo culture = CultureInfo.CreateSpecificCulture("pl-PL");
    culture.NumberFormat.CurrencyNegativePattern = 1;

    decimal walletBalance = Model?.WalletBalance ?? 0m;
    decimal budgetLimit = Model?.MonthlyBudgetLimit ?? 0m;
    decimal currentMonthExpense = ViewBag.CurrentMonthExpense ?? 0m;

    int budgetPercent = budgetLimit > 0
        ? (int)Math.Min(100, Math.Round((currentMonthExpense / budgetLimit) * 100))
        : 0;

    string budgetBarClass = budgetPercent >= 100
        ? "bg-danger"
        : budgetPercent >= 80
            ? "bg-warning"
            : "bg-success";

    var expenseChartItems = ViewBag.CharData as IEnumerable<object>;
    bool hasExpenseChartData = expenseChartItems != null && expenseChartItems.Any();
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show d-flex justify-content-center" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Zamknij"></button>
    </div>
}

@if (TempData["WelcomeUser"] != null)
{
    <div id="welcome-overlay" class="welcome-overlay">
        <div class="welcome-center-card">
            <div class="mb-3">
                <span class="d-inline-flex align-items-center justify-content-center rounded-circle bg-success bg-opacity-10 text-success" style="width: 56px; height: 56px;">
                    <i class="fa-solid fa-hand fa-xl"></i>
                </span>
            </div>
            <h4 class="fw-bold mb-1">Cześć, @TempData["WelcomeUser"]</h4>
            <p class="text-muted small mb-0">Przygotowuję Twój panel finansowy</p>
        </div>
    </div>
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
        <h4 class="fw-bold mb-0">Panel finansowy</h4>
        <small class="text-muted">Podsumowanie Twojego portfela, budżetu i ostatnich operacji</small>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a href="/Transaction/AddOrEdit" class="btn btn-success btn-sm">
            <i class="fa-solid fa-plus me-1"></i>Nowa transakcja
        </a>
        <a href="/Scanner" class="btn btn-outline-primary btn-sm">
            <i class="fa-solid fa-camera me-1"></i>Skaner AI
        </a>
        <a href="/Dashboard/Compare" class="btn btn-outline-secondary btn-sm">
            <i class="fa-solid fa-scale-balanced me-1"></i>Porównaj miesiące
        </a>
        <a href="/Subscription" class="btn btn-outline-secondary btn-sm">
            <i class="fa-solid fa-calendar-check me-1"></i>Subskrypcje
        </a>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-xl-3 col-md-6">
        <div class="summary-card">
            <div class="summary-icon-badge badge-wallet">
                <i class="fa-solid fa-wallet"></i>
            </div>
            <div>
                <div class="text-muted small">Saldo portfela</div>
                <div class="fs-4 fw-bold">@walletBalance.ToString("C2", culture)</div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="summary-card" id="incomeWidget" style="cursor: pointer;">
            <div class="summary-icon-badge badge-income">
                <i class="fa-solid fa-arrow-trend-up"></i>
            </div>
            <div>
                <div class="text-muted small">Przychody</div>
                <div class="fs-4 fw-bold">@ViewBag.Income</div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="summary-card" id="expenseWidget" style="cursor: pointer;">
            <div class="summary-icon-badge badge-expense">
                <i class="fa-solid fa-arrow-trend-down"></i>
            </div>
            <div>
                <div class="text-muted small">Wydatki</div>
                <div class="fs-4 fw-bold">@ViewBag.Expense</div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="summary-card">
            <div class="summary-icon-badge badge-balance">
                <i class="fa-solid fa-sack-dollar"></i>
            </div>
            <div>
                <div class="text-muted small">Bilans transakcji</div>
                <div class="fs-4 fw-bold">@ViewBag.Balance</div>
            </div>
        </div>
    </div>
</div>

<div class="widget p-4 mb-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-2 gap-2">
        <div>
            <h6 class="fw-bold mb-0">Miesięczny limit budżetu</h6>
            @if (budgetLimit > 0)
            {
                <small class="text-muted">
                    Wydano w tym miesiącu: <strong>@currentMonthExpense.ToString("C2", culture)</strong> z <strong>@budgetLimit.ToString("C2", culture)</strong> (@budgetPercent%)
                </small>
            }
            else
            {
                <small class="text-muted">Nie ustawiono jeszcze miesięcznego limitu wydatków.</small>
            }
        </div>
        <a href="/Home/User" class="btn btn-sm btn-outline-secondary">
            <i class="fa-solid fa-sliders me-1"></i>Zmień limit
        </a>
    </div>

    @if (budgetLimit > 0)
    {
        <div class="progress" style="height: 10px;">
            <div class="progress-bar @budgetBarClass" role="progressbar" style="width: @budgetPercent%;" aria-valuenow="@budgetPercent" aria-valuemin="0" aria-valuemax="100"></div>
        </div>
    }
</div>

<div class="modal fade" id="transactionModal" tabindex="-1" aria-labelledby="transactionModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="transactionModalLabel">Podgląd transakcji</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Zamknij"></button>
            </div>
            <div class="modal-body">
                <p class="mb-0">Czy chcesz przejść do listy wszystkich transakcji?</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Anuluj</button>
                <a href="@Url.Action("Index", "Transaction")" class="btn btn-success">Zobacz transakcje</a>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="widget p-3 w-100 h-100 d-flex flex-column">
            <h6 class="fw-bold text-center mb-3">Wydatki według kategorii</h6>
            @if (hasExpenseChartData)
            {
                @(
                            Html.EJS().AccumulationChart("ExpenseChar")
                            .Background("transparent")
                            .EnableSmartLabels(true)
                            .Tooltip(tooltip =>
                            {
                                tooltip.Enable(true);
                                tooltip.Format("${point.x}: ${point.y} zł");
                            })
                            .DataSource(expenseChartItems)
                            .Series(series =>
                            {
                                series.DataLabel(dl => dl.Visible(true)
                            .Position(Syncfusion.EJ2.Charts.AccumulationLabelPosition.Inside)
                            .Font(ft => ft.FontWeight("600"))
                            .Name("formattedAmount"))
                            .XName("categoryTitleWithIcon")
                            .YName("amount")
                            .InnerRadius("55%")
                            .Name("Wydatki")
                            .Border(br => br.Width(1))
                            .LegendShape(Syncfusion.EJ2.Charts.LegendShape.Circle)
                            .ExplodeIndex(0)
                            .DataSource(expenseChartItems)
                            .Add();
                            })
                            .LegendSettings(legend =>
                            {
                                legend.Visible(true);
                                legend.Position(Syncfusion.EJ2.Charts.LegendPosition.Bottom);
                                legend.Width("100%");
                                legend.TextStyle(style => { style.FontWeight("600"); });
                                legend.Padding(10);
                            })
                            .Render()
                            )
                        }
            else
            {
                <div class="flex-grow-1 d-flex flex-column justify-content-center align-items-center text-muted py-5">
                    <i class="fa-solid fa-chart-pie fa-2x mb-2 opacity-50"></i>
                    <span class="small">Brak wydatków do wyświetlenia</span>
                </div>
            }
        </div>
    </div>

    <div class="col-md-8">
        <div class="widget p-3 h-100">
            <h6 class="fw-bold text-center mb-3">Przychody i wydatki (ostatnie 7 dni)</h6>
            @Html.EJS().Chart("container").Background("transparent").Palettes(new string[] { "#28a745", "#dc3545" }).PrimaryXAxis(px => px
                        .ValueType(Syncfusion.EJ2.Charts.ValueType.Category)
                        .MajorGridLines(mg => mg.Width(0))
                        .MajorTickLines(mt => mt.Width(0))
                        ).PrimaryYAxis(py => py
                        .Minimum(0)
                        .MajorGridLines(mg => mg.Width(1).Color("#32414d").DashArray("3,5"))
                        .MajorTickLines(mt => mt.Width(0))
                        .LineStyle(ls => ls.Width(0))
                        ).ChartArea(ca => ca
                        .Border(b => b.Width(0))
                        ).Series(series =>
                        {
                            series.Type(Syncfusion.EJ2.Charts.ChartSeriesType.Spline)
                            .XName("day")
                            .YName("income")
                            .DataSource(ViewBag.ChartData)
                            .Name("Przychody")
                            .Width(3)
                            .Add();
                            series.Type(Syncfusion.EJ2.Charts.ChartSeriesType.Spline)
                            .XName("day")
                            .YName("expense")
                            .DataSource(ViewBag.ChartData)
                            .Name("Wydatki")
                            .Width(3)
                            .Add();
                        }).LegendSettings(legend =>
                        {
                            legend.Position(Syncfusion.EJ2.Charts.LegendPosition.Bottom)
                            .EnableHighlight(true)
                            .Padding(10)
                            .ToggleVisibility(false)
                            .TextStyle(ts => ts.Size("0.9rem"));
                        }).Tooltip(tt => tt.Enable(true).Format("${point.x}: ${point.y} zł")).Render()
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-md-6">
        <div class="widget p-3 h-100">
            <h6 class="fw-bold text-center mb-3">Ostatnie transakcje</h6>
            @Html.EJS().Grid("Transactions").DataSource((IEnumerable<object>)ViewBag.RecentTransactions).Columns(col =>
                        {
                col.Field("CategoryTitleWithIcon").HeaderText("Kategoria").TextAlign(Syncfusion.EJ2.Grids.TextAlign.Left).Add();
                col.Field("Date").HeaderText("Data").Width("125").Type("date").Format("dd.MM.yyyy").TextAlign(Syncfusion.EJ2.Grids.TextAlign.Center).Add();
                col.Field("FormattedAmount").HeaderText("Kwota").Width("125").TextAlign(Syncfusion.EJ2.Grids.TextAlign.Center)
                .Template("#amountTemplate").Add();
            }).GridLines(Syncfusion.EJ2.Grids.GridLine.None).Render()
        </div>
    </div>

    <div class="col-md-6">
        <div class="widget p-3 h-100">
            <h6 class="fw-bold text-center mb-3">Ostatnie kategorie</h6>
            @Html.EJS().Grid("Categories").DataSource((IEnumerable<object>)ViewBag.RecentCategories).Columns(col =>
                        {
                col.Field("TitleWithIcon").HeaderText("Kategoria").TextAlign(Syncfusion.EJ2.Grids.TextAlign.Left).Add();
                col.Field("Type").HeaderText("Typ").Width("125").TextAlign(Syncfusion.EJ2.Grids.TextAlign.Center)
                .Template("#typeTemplate").Add();
            }).GridLines(Syncfusion.EJ2.Grids.GridLine.None).Render()
        </div>
    </div>
</div>

<script id="amountTemplate" type="text/x-template">
    ${if(CategoryType == "Income")}
        <span class="fw-bold text-success">${FormattedAmount}</span>
    ${else}
        <span class="fw-bold text-danger">${FormattedAmount}</span>
    ${/if}
</script>

<script id="typeTemplate" type="text/x-template">
    ${if(Type == "Income")}
        <span class="badge bg-success">Przychód</span>
    ${else}
        <span class="badge bg-danger">Wydatek</span>
    ${/if}
</script>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const incomeWidget = document.getElementById('incomeWidget');
        const expenseWidget = document.getElementById('expenseWidget');
        const modalElement = document.getElementById('transactionModal');

        if (modalElement) {
            const transactionModal = new bootstrap.Modal(modalElement);

            if (incomeWidget) {
                incomeWidget.addEventListener('click', function () {
                    sessionStorage.setItem('transactionFilter', 'income');
                    document.getElementById('transactionModalLabel').textContent = 'Transakcje przychodowe';
                    transactionModal.show();
                });
            }

            if (expenseWidget) {
                expenseWidget.addEventListener('click', function () {
                    sessionStorage.setItem('transactionFilter', 'expense');
                    document.getElementById('transactionModalLabel').textContent = 'Transakcje wydatkowe';
                    transactionModal.show();
                });
            }
        }
    const welcomeOverlay = document.getElementById('welcome-overlay');
    if (welcomeOverlay) {
        setTimeout(function () {
            welcomeOverlay.classList.add('hidden');
            setTimeout(function () {
                welcomeOverlay.remove();
            }, 350);
        }, 1600);
    }
    });
</script>