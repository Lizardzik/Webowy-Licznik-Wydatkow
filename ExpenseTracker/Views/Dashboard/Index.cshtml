@using Syncfusion.EJ2.Notifications
@{
	ViewData["isDashboard"] = true;
}
@model ExpenseTracker.Models.User

@*Success message alert*@
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show d-flex justify-content-center" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@*Welcome message alert*@

@if (TempData["WelcomeUser"] != null)
{
    <div id="welcome-overlay">
        @Html.EJS().Message("welcome-message").Severity(Syncfusion.EJ2.Notifications.Severity.Success).Variant(Syncfusion.EJ2.Notifications.Variant.Text).Content("Welcome, " + TempData["WelcomeUser"] + "!").Render()
    </div>
 
}

@* Summary Widgets*@
<div class="row mb-4">
    <div class="col-md-4">
        <div class="d-flex flex-row widget summary income-widget" id="incomeWidget">
            <div class="d-flex flex-column justify-content-center p-5 icon-wrapper">
                <i class="fa-solid fa-arrow-trend-up fa-2xl"></i>
            </div>
            <div class="d-flex flex-column m-auto py-3 text-wrapper">
                <span class="lead">Total Income</span>
                <h1 class="display-6 fw-bold">@ViewBag.Income</h1>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="d-flex flex-row widget summary expense-widget" id="expenseWidget">
            <div class="d-flex flex-column justify-content-center p-5 icon-wrapper">
                <i class="fa-solid fa-arrow-trend-down fa-2xl"></i>
            </div>
            <div class="d-flex flex-column m-auto py-3 text-wrapper">
                <span class="lead">Total Expenses</span>
                <h1 class="display-6 fw-bold">@ViewBag.Expense</h1>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="d-flex flex-row widget summary balance-widget">
            <div class="d-flex flex-column justify-content-center p-5 icon-wrapper">
                <i class="fa-solid fa-sack-dollar fa-2xl"></i>
            </div>
            <div class="d-flex flex-column m-auto py-3 text-wrapper">
                <span class="lead">Total Balance</span>
                <h1 class="display-6 fw-bold">@ViewBag.Balance</h1>
            </div>
        </div>
    </div>
</div>

@* Transaction Modal *@
<div class="modal fade" id="transactionModal" tabindex="-1" aria-labelledby="transactionModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="transactionModalLabel">View Transactions</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Do you want to see all of your transactions?</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <a href="@Url.Action("Index", "Transaction")" class="btn btn-primary">View Transactions</a>
            </div>
        </div>
    </div>
</div>
@*Widget Charts*@
<div class="row mb-4">
    <div class="col-md-4">
        <div class="widget chart  expense-widget-chart w-100">
            <div class="title p-4">
                <h5 class="fw-bold text-center">My Expenses</h5>
            </div>
                @(
                    Html.EJS().AccumulationChart("ExpenseChar")
                        .EnableSmartLabels(true)
                        .Tooltip(tooltip =>
                        {
                            tooltip.Enable(true);
                            tooltip.Format("${point.x}: ${point.y}");
                        })
                        .DataSource((IEnumerable<object>)ViewBag.CharData)
                        .Series(series =>
                        {
                            series.DataLabel(dl => dl.Visible(true)
                            .Position(Syncfusion.EJ2.Charts.AccumulationLabelPosition.Inside)
                            .Font(ft => ft.FontWeight("600").Color("black"))
                            .Name("formattedAmount"))
                            .XName("categoryTitleWithIcon")
                            .YName("amount")
                            .InnerRadius("55%")
                            .Name("Expense").Border(br => br.Width(1))
                            .LegendShape(Syncfusion.EJ2.Charts.LegendShape.Circle)
                            .ExplodeIndex(0).DataSource(ViewBag.CharData).Add();
                        })
                        .LegendSettings(legend =>
                        {
                            legend.Visible(true);
                            legend.Position(Syncfusion.EJ2.Charts.LegendPosition.Bottom); 
                            legend.Width("100%");
                            legend.TextStyle(style => { style.FontWeight("600").Color("#000"); });
                            legend.Padding(10);
                    })
                    .Render()
                    )
            
            </div>
        </div>
    <div class="col-md-8">
        <div class="widget balance-widget-chart">
            <div class="title p-4">
                        <h5 class="fw-bold text-center">Income VS Expense</h5>
                    </div>
                @Html.EJS().Chart("container").Palettes(new string[] { "#28a745", "#dc3545" }).PrimaryXAxis(px => px
                         .ValueType(Syncfusion.EJ2.Charts.ValueType.Category)
                         .LabelStyle(ls => ls.Color("#000"))
                         .MajorGridLines(mg => mg.Width(0))
                         .MajorTickLines(mt => mt.Width(0))
                         ).PrimaryYAxis(py => py
                         .LabelStyle(ls => ls.Color("#000"))
                         .MajorGridLines(mg => mg.Width(1).Color("#32414d").DashArray("3,5"))
                         .MajorTickLines(mt => mt.Width(0))
                         .LineStyle(ls => ls.Width(0))
                         ).ChartArea(ca => ca
                         .Border(b => b.Width(0))
                         ).Series(series =>
                         {
                             series.Type(Syncfusion.EJ2.Charts.ChartSeriesType.Spline)
                             .XName("day")
                             .YName("income")
                             .DataSource(ViewBag.ChartData)
                             .Name("Income")
                             .Width(3)
                             .Add();
                             series.Type(Syncfusion.EJ2.Charts.ChartSeriesType.Spline)
                             .XName("day")
                             .YName("expense")
                             .DataSource(ViewBag.ChartData)
                             .Name("Expense")
                             .Width(3)
                             .Add();
                         }).PrimaryYAxis(axis => axis.Minimum(-1000)).LegendSettings(legend =>
                         {
                             legend.Position(Syncfusion.EJ2.Charts.LegendPosition.Bottom)
                             .EnableHighlight(true)
                             .Padding(10)
                             .ToggleVisibility(false)
                             .TextStyle(ts => ts.Color("#000").Size("1rem"));
                         }).Tooltip(tt => tt.Enable(true).Format("${point.x}: ${point.y}")).Render()
           </div>
      </div>
 </div>

@*Recent transactions and Categories*@


<div class="row">
    <div class="col-md-6">
        <div class="widget" style="height: 410px !important;">
            <div class="title p-4">
                <h5 class="fw-bold text-center">Recently Added Transactions</h5>
                <hr />
            </div>
            <div class="px-4 pb-4">
                @Html.EJS().Grid("Transactions").DataSource((IEnumerable<object>)ViewBag.RecentTransactions).Columns(col =>
                         {
                             col.Field("CategoryTitleWithIcon").HeaderText("Category").TextAlign(Syncfusion.EJ2.Grids.TextAlign.Left).Add();
                             col.Field("Date").HeaderText("Added On").Width("140").Type("date").Format("dd-MMM-yy").TextAlign(Syncfusion.EJ2.Grids.TextAlign.Center).Add();
                             col.Field("FormattedAmount").HeaderText("Amount").Width("130").TextAlign(Syncfusion.EJ2.Grids.TextAlign.Center)
                             .Template("#amountTemplate").Add();
                         }).GridLines(Syncfusion.EJ2.Grids.GridLine.None).Render()
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="widget" style="height: 410px !important;">
            <div class="title p-4">
                <h5 class="fw-bold text-center">Recently Added Categories</h5>
                <hr />
            </div>
            <div class="px-4 pb-4">
                @Html.EJS().Grid("Categories").DataSource((IEnumerable<object>)ViewBag.RecentCategories).Columns(col =>
                         {
                             col.Field("TitleWithIcon").HeaderText("Category").TextAlign(Syncfusion.EJ2.Grids.TextAlign.Left).Add();
                             col.Field("Type").HeaderText("Type").Width("130").TextAlign(Syncfusion.EJ2.Grids.TextAlign.Center)
                             .Template("#typeTemplate").Add();
                         }).GridLines(Syncfusion.EJ2.Grids.GridLine.None).Render()
            </div>
        </div>
    </div>
</div>

<script id="amountTemplate" type="text/x-template">
    ${if(CategoryType == "Income")}
        <span style="color:green">${FormattedAmount}</span>
    ${else}
        <span style="color:red">${FormattedAmount}</span>
    ${/if}
</script>

<script id="typeTemplate" type="text/x-template">
    ${if(Type == "Income")}
        <span class="badge bg-success">${Type}</span>
    ${else}
        <span class="badge bg-danger">${Type}</span>
    ${/if}
</script>




<script>
    document.addEventListener('DOMContentLoaded', function () {
        // Income and Expense widget click handlers
        var incomeWidget = document.getElementById('incomeWidget');
        var expenseWidget = document.getElementById('expenseWidget');
        var transactionModal = new bootstrap.Modal(document.getElementById('transactionModal'));
        var loadingElements = document.querySelectorAll('.e-spin-material, .e-spin-bootstrap, .e-spin-fabric, .e-loading');
        loadingElements.forEach(function (el) {
            el.style.display = 'none';
        });

       

        incomeWidget.addEventListener('click', function() {
            sessionStorage.setItem('transactionFilter', 'income');
            document.getElementById('transactionModalLabel').textContent = 'Income Transactions';
            transactionModal.show();
        });

        expenseWidget.addEventListener('click', function() {
            sessionStorage.setItem('transactionFilter', 'expense');
            document.getElementById('transactionModalLabel').textContent = 'Expense Transactions';
            transactionModal.show();
        });

        //Welcome message
         setTimeout(function() {
                var welcomeOverlay = document.getElementById('welcome-overlay');
                if (welcomeOverlay) {
                    welcomeOverlay.style.animation = 'fadeOut 0.8s';
                    setTimeout(function() {
                        welcomeOverlay.style.display = 'none';
                        

                        // Show loading elements again if needed
                        loadingElements.forEach(function(el) {
                            el.style.display = '';
                        });
                    }, 800);
                }
            }, 2000);
        });


</script>

