@using System.Globalization
@model List<ExpenseTracker.Models.ScannedTransactionDto>
@{
    ViewData["PageTitle"] = "Skaner AI Paragonów i Zrzutów";
    var categories = ViewBag.Categories as List<ExpenseTracker.Models.Category> ?? new();
    string usedModel = ViewBag.UsedModel as string ?? string.Empty;
    ViewData["UseLoader"] = true;
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger mb-4" role="alert">
        <i class="fa-solid fa-circle-exclamation me-2"></i>@TempData["ErrorMessage"]
    </div>
}

<div class="row g-4">
    <div class="col-lg-5">
        <div class="widget p-4 h-100">
            <h5 class="fw-bold mb-2">
                <i class="fa-solid fa-camera text-success me-2"></i>Wczytaj obraz
            </h5>
            <p class="text-muted small mb-3">
                Wybierz zdjęcie paragonu z dysku albo zrób zrzut ekranu w banku i wciśnij <strong>Ctrl + V</strong> w dowolnym miejscu na tej stronie.
            </p>

            <form asp-action="Analyze" method="post" enctype="multipart/form-data" id="scannerUploadForm">
                @Html.AntiForgeryToken()
                <div id="dropZone" class="scanner-dropzone rounded-3 p-4 text-center mb-3">
                    <i class="fa-solid fa-cloud-arrow-up fa-3x text-success mb-2"></i>
                    <p class="fw-semibold mb-1" id="dropZoneTitle">Kliknij, przeciągnij plik lub wklej (Ctrl + V)</p>
                    <span class="text-muted small">Obsługiwane formaty: PNG, JPG, WEBP</span>
                    <input type="file" name="receiptImage" id="receiptImageInput" class="d-none" accept="image/*" />
                </div>

                <div id="imagePreviewWrapper" class="mb-3 d-none text-center">
                    <img id="imagePreview" src="#" alt="Podgląd dokumentu" class="img-fluid rounded border" style="max-height: 220px;" />
                </div>

                <button type="submit" id="analyzeSubmitBtn" class="btn btn-success w-100 py-2 fw-bold" disabled>
                    <i class="fa-solid fa-microchip me-2"></i>Analizuj obraz przez AI
                </button>
            </form>
        </div>
    </div>

    <div class="col-lg-7">
        <div class="widget p-4 h-100">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                <h5 class="fw-bold mb-0">
                    <i class="fa-solid fa-list-check text-primary me-2"></i>Wykryte transakcje do zatwierdzenia
                </h5>
                @if (!string.IsNullOrEmpty(usedModel))
                {
                    <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-3 py-2">
                        <i class="fa-solid fa-robot me-1"></i>Model: @usedModel
                    </span>
                }
            </div>

            @if (Model == null || !Model.Any())
            {
                <div class="text-center py-5 text-muted">
                    <i class="fa-solid fa-receipt fa-4x mb-3 opacity-50"></i>
                    <p class="mb-0">Prześlij paragon lub zrzut ekranu po lewej stronie, aby zobaczyć listę rozpoznanych operacji.</p>
                </div>
            }
            else
            {
                <form asp-action="Confirm" method="post">
                    @Html.AntiForgeryToken()
                    <div id="scannedItemsList" class="d-flex flex-column gap-3">
                        @for (int i = 0; i < Model.Count; i++)
                        {
                            <div class="scanned-item-card p-3 rounded-3 border">
                                <div class="row g-2 mb-2">
                                    <div class="col-sm-6">
                                        <label class="form-label small text-muted mb-1">Kategoria</label>
                                        <select name="transactions[@i].CategoryId" class="form-select form-select-sm" data-category-select="true">
                                            @foreach (var cat in categories)
                                            {
                                                <option value="@cat.CategoryId" data-icon="@cat.Icon" data-type="@cat.Type" selected="@(cat.CategoryId == Model[i].CategoryId)">
                                                    @cat.Title
                                                </option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-sm-6">
                                        <label class="form-label small text-muted mb-1">Opis / Sklep</label>
                                        <input type="text" name="transactions[@i].Note" value="@Model[i].Note" class="form-control form-control-sm" placeholder="Nazwa sklepu lub tytuł" />
                                    </div>
                                </div>

                                <div class="row g-2 align-items-end">
                                    <div class="col-5">
                                        <label class="form-label small text-muted mb-1">Data</label>
                                        <input type="date" name="transactions[@i].Date" value="@Model[i].Date.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
                                    </div>
                                    <div class="col-5">
                                        <label class="form-label small text-muted mb-1">Kwota (zł)</label>
                                        <input type="number" name="transactions[@i].Amount" value="@Model[i].Amount.ToString("0.00", CultureInfo.InvariantCulture)" step="0.01" min="0.01" inputmode="decimal" class="form-control form-control-sm fw-bold" />
                                    </div>
                                    <div class="col-2 text-end">
                                        <button type="button" class="btn btn-sm btn-outline-danger w-100 remove-row-btn" title="Usuń pozycję">
                                            <i class="fa-solid fa-trash-can"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    <template id="scannedItemTemplate">
                        <div class="scanned-item-card p-3 rounded-3 border">
                            <div class="row g-2 mb-2">
                                <div class="col-sm-6">
                                    <label class="form-label small text-muted mb-1">Kategoria</label>
                                    <select name="transactions[0].CategoryId" class="form-select form-select-sm" data-category-select="true">
                                        @foreach (var cat in categories)
                                        {
                                            <option value="@cat.CategoryId" data-icon="@cat.Icon" data-type="@cat.Type">
                                                @cat.Title
                                            </option>
                                        }
                                    </select>
                                </div>
                                <div class="col-sm-6">
                                    <label class="form-label small text-muted mb-1">Opis / Sklep</label>
                                    <input type="text" name="transactions[0].Note" value="" class="form-control form-control-sm" placeholder="Nazwa sklepu lub tytuł" />
                                </div>
                            </div>

                            <div class="row g-2 align-items-end">
                                <div class="col-5">
                                    <label class="form-label small text-muted mb-1">Data</label>
                                    <input type="date" name="transactions[0].Date" value="@DateTime.Today.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
                                </div>
                                <div class="col-5">
                                    <label class="form-label small text-muted mb-1">Kwota (zł)</label>
                                    <input type="number" name="transactions[0].Amount" value="10.00" step="0.01" min="0.01" inputmode="decimal" class="form-control form-control-sm fw-bold" />
                                </div>
                                <div class="col-2 text-end">
                                    <button type="button" class="btn btn-sm btn-outline-danger w-100 remove-row-btn" title="Usuń pozycję">
                                        <i class="fa-solid fa-trash-can"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </template>

                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-4 pt-3 border-top">
                        <button type="button" id="addManualRowBtn" class="btn btn-sm btn-outline-primary">
                            <i class="fa-solid fa-plus me-1"></i>Dodaj pozycję ręcznie
                        </button>
                        <div class="d-flex gap-2">
                            <a href="/Scanner" class="btn btn-sm btn-outline-secondary px-3">Wyczyść</a>
                            <button type="submit" class="btn btn-sm btn-success px-4 fw-bold">
                                <i class="fa-solid fa-check me-2"></i>Zapisz do portfela
                            </button>
                        </div>
                    </div>
                </form>
            }
        </div>
    </div>
</div>

<style>
    .scanner-dropzone {
        border: 2px dashed #94a3b8;
        cursor: pointer;
        transition: border-color 0.2s ease, background-color 0.2s ease;
    }

        .scanner-dropzone:hover,
        .scanner-dropzone.drag-active {
            border-color: #28a745;
            background-color: rgba(40, 167, 69, 0.06);
        }

    .scanned-item-card {
        background-color: #f8fafc;
        border-color: #dee2e6 !important;
    }

    body.dark-mode .scanned-item-card {
        background-color: #151a24;
        border-color: #2d3748 !important;
    }
</style>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const dropZone = document.getElementById('dropZone');
            const fileInput = document.getElementById('receiptImageInput');
            const previewWrapper = document.getElementById('imagePreviewWrapper');
            const previewImg = document.getElementById('imagePreview');
            const submitBtn = document.getElementById('analyzeSubmitBtn');
            const dropZoneTitle = document.getElementById('dropZoneTitle');
            const uploadForm = document.getElementById('scannerUploadForm');

            function handleFileSelection(file) {
                if (!file || !file.type.startsWith('image/')) {
                    return;
                }

                const dataTransfer = new DataTransfer();
                dataTransfer.items.add(file);
                fileInput.files = dataTransfer.files;

                const reader = new FileReader();
                reader.onload = function (event) {
                    previewImg.src = event.target.result;
                    previewWrapper.classList.remove('d-none');
                    dropZoneTitle.textContent = file.name || 'Obraz ze schowka';
                    submitBtn.disabled = false;
                };
                reader.readAsDataURL(file);
            }

            dropZone.addEventListener('click', function () {
                fileInput.click();
            });

            fileInput.addEventListener('change', function () {
                if (this.files.length > 0) {
                    handleFileSelection(this.files[0]);
                }
            });

            dropZone.addEventListener('dragover', function (event) {
                event.preventDefault();
                dropZone.classList.add('drag-active');
            });

            dropZone.addEventListener('dragleave', function () {
                dropZone.classList.remove('drag-active');
            });

            dropZone.addEventListener('drop', function (event) {
                event.preventDefault();
                dropZone.classList.remove('drag-active');
                if (event.dataTransfer.files.length > 0) {
                    handleFileSelection(event.dataTransfer.files[0]);
                }
            });

            document.addEventListener('paste', function (event) {
                const items = event.clipboardData?.items;
                if (!items) {
                    return;
                }

                for (let i = 0; i < items.length; i++) {
                    if (items[i].type.indexOf('image') !== -1) {
                        const imageBlob = items[i].getAsFile();
                        handleFileSelection(imageBlob);
                        break;
                    }
                }
            });

            uploadForm.addEventListener('submit', function () {
                submitBtn.disabled = true;
                submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Analizowanie obrazu...';
            });

            function bindRemoveButtons() {
                document.querySelectorAll('.remove-row-btn').forEach(function (button) {
                    button.onclick = function () {
                        const card = this.closest('.scanned-item-card');
                        if (document.querySelectorAll('#scannedItemsList .scanned-item-card').length > 1) {
                            card.remove();
                            reindexItems();
                        }
                    };
                });
            }

            function reindexItems() {
                const cards = document.querySelectorAll('#scannedItemsList .scanned-item-card');
                cards.forEach(function (card, index) {
                    card.querySelectorAll('select, input').forEach(function (field) {
                        const fieldName = field.getAttribute('name');
                        if (fieldName) {
                            field.setAttribute('name', fieldName.replace(/\[\d+\]/, `[${index}]`));
                        }
                    });
                });
            }

            bindRemoveButtons();

            const addManualBtn = document.getElementById('addManualRowBtn');
            const itemTemplate = document.getElementById('scannedItemTemplate');
            if (addManualBtn && itemTemplate) {
                addManualBtn.addEventListener('click', function () {
                    const list = document.getElementById('scannedItemsList');
                    const fragment = itemTemplate.content.cloneNode(true);
                    list.appendChild(fragment);
                    const addedCard = list.lastElementChild;
                    reindexItems();
                    if (typeof window.initCategorySelects === 'function' && addedCard) {
                        window.initCategorySelects(addedCard);
                    }
                    bindRemoveButtons();
                });
            }
        });
    </script>
}