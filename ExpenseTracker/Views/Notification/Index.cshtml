@model IEnumerable<ExpenseTracker.Models.Notification>
@{
    ViewData["Title"] = "Powiadomienia";
}

<div class="card mt-4">
    <div class="card-body">

        @if (Model != null && Model.Any())
        {
            <div class="notification-list">
                @foreach (var notification in Model)
                {
                    <div class="notification-item @(notification.IsRead ? "bg-light" : "")"
                         data-id="@notification.Id"
                         data-type="@((int)notification.Type)">
                        <div class="d-flex justify-content-between align-items-center">
                            <span>
                                @if (notification.Type == ExpenseTracker.Models.NotificationType.TransactionAdded)
                                {
                                    <i class="fa-solid fa-circle-plus text-primary icon"></i>
                                    <strong>@notification.Message</strong>
                                }
                                else if (notification.Type == ExpenseTracker.Models.NotificationType.WeeklyReport)
                                {
                                    <i class="fa-solid fa-chart-line text-success icon"></i>
                                    <span>Weekly Report</span>
                                    }
                            </span>
                            <small>@notification.CreatedAt.ToString("MM/dd/yyyy HH:mm")</small>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-center py-3">
                <i class="fa-solid fa-bell-slash fa-2x text-muted mb-2"></i>
                <p class="text-muted mb-0">Brak powiadomień</p>
            </div>
        }
    </div>
</div>


<script>
    document.addEventListener('DOMContentLoaded', function () {
        // Obsługa przycisku "Oznacz wszystkie jako przeczytane"
        var markAllReadBtn = document.getElementById('markAllReadBtn');

        if (markAllReadBtn) {
            markAllReadBtn.addEventListener('click', function () {
                fetch('@Url.Action("MarkAllAsRead", "Notification")', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    }
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        // Oznaczanie jako przeczytane w UI
                        document.querySelectorAll('.notification-item').forEach(item => {
                            item.classList.add('bg-light');
                        });

                        console.log('Wszystkie powiadomienia oznaczone jako przeczytane');
                    }
                })
                .catch(error => console.error('Błąd:', error));
            });
        }
    });
</script>