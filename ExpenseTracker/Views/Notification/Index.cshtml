@model IEnumerable<ExpenseTracker.Models.Notification>
@{
    ViewData["PageTitle"] = "Powiadomienia";
}

<div class="widget p-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <h5 class="fw-bold mb-0">Historia powiadomień i raportów</h5>
        @if (Model != null && Model.Any(n => !n.IsRead))
        {
            <button type="button" id="pageMarkAllReadBtn" class="btn btn-sm btn-outline-success">
                <i class="fa-solid fa-check-double me-1"></i>Oznacz wszystkie jako przeczytane
            </button>
        }
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="notification-list d-flex flex-column gap-2">
            @foreach (var notification in Model)
            {
                bool isWeeklyReport = notification.Type == ExpenseTracker.Models.NotificationType.WeeklyReport;
                string displayMessage = string.IsNullOrWhiteSpace(notification.Message)
                ? (isWeeklyReport ? "Nowy raport tygodniowy" : "Nowa transakcja")
                : notification.Message;

                <div class="notification-item p-3 rounded border @(notification.IsRead ? "opacity-75" : "border-success")"
                     data-id="@notification.Id"
                     data-type="@((int)notification.Type)">
                    <div class="d-flex justify-content-between align-items-start gap-3">
                        <div class="d-flex align-items-center gap-2">
                            @if (isWeeklyReport)
                            {
                                <i class="fa-solid fa-chart-line text-success"></i>
                            }
                            else
                            {
                                <i class="fa-solid fa-circle-plus text-primary"></i>
                            }
                            <span class="@(notification.IsRead ? "fw-normal" : "fw-bold")">@displayMessage</span>
                        </div>
                        <small class="text-muted text-nowrap">@notification.CreatedAt.ToString("dd.MM.yyyy HH:mm")</small>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center py-4">
            <i class="fa-solid fa-bell-slash fa-2x text-muted mb-2"></i>
            <p class="text-muted mb-0">Brak powiadomień do wyświetlenia.</p>
        </div>
    }
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const pageMarkAllBtn = document.getElementById('pageMarkAllReadBtn');
            if (!pageMarkAllBtn) return;

            pageMarkAllBtn.addEventListener('click', function () {
                fetch('@Url.Action("MarkAllAsRead", "Notification")', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' }
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        document.querySelectorAll('.notification-item').forEach(item => {
                            item.classList.remove('border-success');
                            item.classList.add('opacity-75');
                        });
                        pageMarkAllBtn.remove();
                    }
                });
            });
        });
    </script>
}